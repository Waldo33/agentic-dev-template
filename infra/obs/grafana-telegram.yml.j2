# Контакт-точка Telegram для тревог Grafana. Рендерит Ansible (роль obs_stack) — значения строками:
# подстановка $VAR в провижининге Grafana превращала цифровой ID чата в число, и Grafana не стартовала.
apiVersion: 1

contactPoints:
  - orgId: 1
    name: telegram
    receivers:
      - uid: telegram
        type: telegram
        settings:
          bottoken: '{{ telegram_bot_token }}'
          chatid: '{{ telegram_chat_id }}'
          parse_mode: HTML

policies:
  - orgId: 1
    receiver: telegram
    group_by: [alertname]
    group_wait: 30s
    group_interval: 5m
    repeat_interval: 4h
