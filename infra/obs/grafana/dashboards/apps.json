{
  "uid": "lab-apps",
  "title": "Приложения",
  "tags": [
    "lab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Приложение",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": {
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT DISTINCT app FROM analytics.events WHERE ts > now() - INTERVAL 90 DAY ORDER BY app"
        },
        "refresh": 2,
        "current": {},
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Продукт",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "События по типам",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, event, count() AS n FROM analytics.events WHERE $__timeFilter(ts) AND app = '${app}' GROUP BY time, event ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Уникальные посетители",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, uniq(anon_id) AS visitors FROM analytics.events WHERE $__timeFilter(ts) AND app = '${app}' GROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 3
    },
    {
      "type": "table",
      "title": "Воронка page_view → signup → activation",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT level AS step, count() AS users FROM (SELECT anon_id, windowFunnel(604800)(toDateTime(ts), event = 'page_view', event = 'signup', event = 'activation') AS level FROM analytics.events WHERE $__timeFilter(ts) AND app = '${app}' GROUP BY anon_id) WHERE level > 0 GROUP BY level ORDER BY level"
        }
      ],
      "id": 4
    },
    {
      "type": "table",
      "title": "Удержание D1 / D7 / D30",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT round(avg(r[2]) * 100, 1) AS d1, round(avg(r[3]) * 100, 1) AS d7, round(avg(r[4]) * 100, 1) AS d30 FROM (SELECT anon_id, retention(toDate(ts) = first, toDate(ts) = first + 1, toDate(ts) = first + 7, toDate(ts) = first + 30) AS r FROM analytics.events INNER JOIN (SELECT anon_id, min(toDate(ts)) AS first FROM analytics.events WHERE app = '${app}' GROUP BY anon_id) USING anon_id WHERE app = '${app}' GROUP BY anon_id)"
        }
      ],
      "id": 5
    },
    {
      "type": "table",
      "title": "Варианты флагов: события и пользователи",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT k AS flag, v AS value, count() AS events, uniq(anon_id) AS users FROM analytics.events ARRAY JOIN mapKeys(flags) AS k, mapValues(flags) AS v WHERE $__timeFilter(ts) AND app = '${app}' GROUP BY k, v ORDER BY k, v"
        }
      ],
      "id": 6
    },
    {
      "type": "row",
      "title": "Надёжность",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Запросы и 5xx (kamal-proxy)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, count() AS requests, countIf(JSONExtractInt(attrs, 'status') >= 500) AS errors_5xx FROM logs.container_logs WHERE $__timeFilter(ts) AND container = 'kamal-proxy' AND JSONExtractString(attrs, 'host') LIKE '${app}.%' GROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Ошибки в логах приложения",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, count() AS errors FROM logs.container_logs WHERE $__timeFilter(ts) AND service = 'lab-${app}' AND level IN ('error', 'fatal') GROUP BY time ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 9
    },
    {
      "type": "table",
      "title": "Частые ошибки",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT any(message) AS message, count() AS n, max(ts) AS last FROM logs.container_logs WHERE $__timeFilter(ts) AND service = 'lab-${app}' AND level IN ('error', 'fatal') GROUP BY cityHash64(substring(message, 1, 120)) ORDER BY n DESC LIMIT 20"
        }
      ],
      "id": 10
    },
    {
      "type": "row",
      "title": "Серверы",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Нагрузка (load average 1 мин)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, host, avgIf(value, name = 'host_load1') AS load1 FROM metrics.host WHERE $__timeFilter(ts) GROUP BY time, host ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Память занята, %",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 8,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, host, 100 * (1 - avgIf(value, name = 'host_memory_available_bytes') / greatest(avgIf(value, name = 'host_memory_total_bytes'), 1)) AS mem FROM metrics.host WHERE $__timeFilter(ts) GROUP BY time, host ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Диск занят, %",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 16,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, host, 100 * maxIf(value, name = 'host_filesystem_used_ratio') AS disk FROM metrics.host WHERE $__timeFilter(ts) GROUP BY time, host ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 14
    }
  ],
  "description": "Продуктовые метрики, надёжность и ресурсы. Источник — ClickHouse (analytics.events, logs.container_logs, metrics.host). Правится файлом в infra/obs/grafana/dashboards."
}