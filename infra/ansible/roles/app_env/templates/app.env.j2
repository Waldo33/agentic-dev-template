# Сгенерировано Ansible (роль app_env). Не править руками — перезапишется.
DATABASE_URL=postgres://{{ app | replace('-', '_') }}:{{ pg_password }}@lab-postgres:5432/{{ app | replace('-', '_') }}
{% if obs.CH_WRITER_PASSWORD is defined %}
CLICKHOUSE_URL=https://ch.{{ base_domain }}
CLICKHOUSE_USER=writer
CLICKHOUSE_PASSWORD={{ obs.CH_WRITER_PASSWORD }}
FLIPT_URL=https://apps:{{ obs.FLAGS_APP_PASSWORD }}@flags.{{ base_domain }}
FLIPT_NAMESPACE={{ app }}
FLIPT_ENVIRONMENT=production
{% endif %}
{% if sentry_dsn %}
SENTRY_DSN={{ sentry_dsn }}
{% endif %}
